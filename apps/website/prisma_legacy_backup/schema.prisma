generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
}

model User {
  id            String       @id @default(cuid())
  name          String?
  email         String       @unique
  password      String?
  role          String       @default("ADMINISTRATOR")
  department    String?      @default("Engineering")
  status        String       @default("ACTIVE")
  avatar        String?
  mfaEnabled    Boolean      @default(false)
  createdAt     DateTime     @default(now())
  updatedAt     DateTime     @updatedAt
  emailVerified DateTime?
  image         String?
  accounts      Account[]
  auditLogs     AuditLog[]
  assets        MediaAsset[]
  sessions      Session[]

  @@index([email])
  @@index([role])
}

model Role {
  id          String       @id @default(cuid())
  name        String       @unique
  description String?
  isCustom    Boolean      @default(false)
  createdAt   DateTime     @default(now())
  updatedAt   DateTime     @updatedAt
  permissions Permission[]
}

model Permission {
  id        String   @id @default(cuid())
  roleId    String
  action    String
  resource  String
  granted   Boolean  @default(true)
  createdAt DateTime @default(now())
  role      Role     @relation(fields: [roleId], references: [id], onDelete: Cascade)

  @@index([roleId])
}

model Session {
  id           String   @id @default(cuid())
  userId       String
  sessionToken String   @unique
  ipAddress    String?
  userAgent    String?
  expiresAt    DateTime
  createdAt    DateTime @default(now())
  user         User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@index([sessionToken])
}

model AuditLog {
  id        String   @id @default(cuid())
  userId    String?
  userEmail String?
  action    String
  resource  String?
  details   String?
  ipAddress String?
  createdAt DateTime @default(now())
  user      User?    @relation(fields: [userId], references: [id])

  @@index([action])
  @@index([userEmail])
  @@index([createdAt])
}

model Page {
  id        String            @id @default(cuid())
  title     String
  slug      String            @unique
  status    String            @default("PUBLISHED")
  author    String            @default("Dragon CMS Team")
  category  String            @default("General")
  createdAt DateTime          @default(now())
  updatedAt DateTime          @updatedAt
  revisions ContentRevision[]
  sections  PageSection[]
  seoData   SEOData?

  @@index([slug])
  @@index([status])
}

model PageSection {
  id        String         @id @default(cuid())
  pageId    String
  title     String
  order     Int            @default(0)
  visible   Boolean        @default(true)
  createdAt DateTime       @default(now())
  updatedAt DateTime       @updatedAt
  blocks    ContentBlock[]
  page      Page           @relation(fields: [pageId], references: [id], onDelete: Cascade)

  @@index([pageId])
}

model ContentBlock {
  id           String       @id @default(cuid())
  key          String       @unique
  category     String       @default("General")
  label        String
  type         String       @default("text")
  content      String
  draftContent String?
  isPublished  Boolean      @default(true)
  version      Int          @default(1)
  updatedBy    String       @default("Admin")
  sectionId    String?
  createdAt    DateTime     @default(now())
  updatedAt    DateTime     @updatedAt
  section      PageSection? @relation(fields: [sectionId], references: [id])

  @@index([key])
  @@index([category])
}

model ContentRevision {
  id        String   @id @default(cuid())
  pageId    String?
  blockKey  String?
  version   Int      @default(1)
  content   String
  changedBy String   @default("Admin")
  createdAt DateTime @default(now())
  page      Page?    @relation(fields: [pageId], references: [id], onDelete: Cascade)

  @@index([pageId])
  @@index([blockKey])
}

model SEOData {
  id              String   @id @default(cuid())
  pageId          String?  @unique
  metaTitle       String
  metaDescription String
  keywords        String
  ogImage         String?
  canonicalUrl    String?
  robots          String   @default("index, follow")
  structuredData  String?
  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt
  page            Page?    @relation(fields: [pageId], references: [id], onDelete: Cascade)
}

model GameContent {
  id           String         @id @default(cuid())
  slug         String         @unique
  name         String
  subtitle     String?
  genre        String
  status       String         @default("In Development")
  releaseDate  String
  developer    String         @default("Dragon Studios")
  publisher    String         @default("Dragon Interactive")
  engine       String         @default("Dragon Engine v5.4")
  platforms    String
  description  String
  logoUrl      String?
  bannerUrl    String?
  heroVideoUrl String?
  features     String?
  requirements String?
  isPublished  Boolean        @default(true)
  createdAt    DateTime       @default(now())
  updatedAt    DateTime       @updatedAt
  dlcList      DLC[]
  gameFeatures GameFeature[]
  mediaList    GameMedia[]
  platformList GamePlatform[]
  patchNotes   PatchNote[]

  @@index([slug])
  @@index([status])
}

model GameMedia {
  id        String      @id @default(cuid())
  gameId    String
  type      String
  url       String
  title     String?
  createdAt DateTime    @default(now())
  game      GameContent @relation(fields: [gameId], references: [id], onDelete: Cascade)

  @@index([gameId])
}

model GameFeature {
  id          String      @id @default(cuid())
  gameId      String
  title       String
  description String
  icon        String?
  game        GameContent @relation(fields: [gameId], references: [id], onDelete: Cascade)

  @@index([gameId])
}

model GamePlatform {
  id          String      @id @default(cuid())
  gameId      String
  name        String
  storeUrl    String?
  releaseDate String?
  game        GameContent @relation(fields: [gameId], references: [id], onDelete: Cascade)

  @@index([gameId])
}

model PatchNote {
  id         String      @id @default(cuid())
  gameId     String
  version    String
  title      String
  changes    String
  releasedAt DateTime    @default(now())
  game       GameContent @relation(fields: [gameId], references: [id], onDelete: Cascade)

  @@index([gameId])
}

model DLC {
  id          String      @id @default(cuid())
  gameId      String
  name        String
  description String
  price       String?     @default("$19.99")
  status      String      @default("AVAILABLE")
  game        GameContent @relation(fields: [gameId], references: [id], onDelete: Cascade)

  @@index([gameId])
}

model NewsArticle {
  id            String   @id @default(cuid())
  slug          String   @unique
  title         String
  excerpt       String
  content       String
  author        String   @default("Dragon Dispatches")
  category      String   @default("Game Updates")
  tags          String   @default("News, Update")
  featuredImage String?
  status        String   @default("PUBLISHED")
  publishedAt   DateTime @default(now())
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt

  @@index([slug])
  @@index([status])
}

model NavigationMenu {
  id        String   @id @default(cuid())
  name      String   @unique
  items     String
  updatedBy String   @default("Admin")
  updatedAt DateTime @updatedAt
}

model MediaAsset {
  id         String       @id @default(cuid())
  name       String
  size       String
  type       String
  mimeType   String?      @default("image/png")
  category   String       @default("Images")
  url        String
  altText    String?
  dimensions String?      @default("1920x1080")
  folderId   String?
  uploaderId String?
  createdAt  DateTime     @default(now())
  updatedAt  DateTime     @updatedAt
  folder     MediaFolder? @relation(fields: [folderId], references: [id])
  uploader   User?        @relation(fields: [uploaderId], references: [id])
  tags       MediaTag[]
  usages     MediaUsage[]

  @@index([name])
  @@index([category])
  @@index([folderId])
}

model MediaFolder {
  id        String       @id @default(cuid())
  name      String       @unique
  slug      String       @unique
  path      String       @default("/")
  createdAt DateTime     @default(now())
  assets    MediaAsset[]
}

model MediaCollection {
  id          String   @id @default(cuid())
  name        String   @unique
  description String?
  createdAt   DateTime @default(now())
}

model MediaTag {
  id      String     @id @default(cuid())
  assetId String
  name    String
  asset   MediaAsset @relation(fields: [assetId], references: [id], onDelete: Cascade)

  @@index([assetId])
}

model MediaUsage {
  id        String     @id @default(cuid())
  assetId   String
  location  String
  createdAt DateTime   @default(now())
  asset     MediaAsset @relation(fields: [assetId], references: [id], onDelete: Cascade)

  @@index([assetId])
}

model UploadHistory {
  id        String   @id @default(cuid())
  fileName  String
  fileSize  String
  status    String   @default("COMPLETED")
  createdAt DateTime @default(now())
}

model Customer {
  id        String   @id @default(cuid())
  name      String
  email     String   @unique
  country   String?  @default("Global")
  language  String?  @default("English")
  notes     String?
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  tickets   Ticket[]

  @@index([email])
}

model Ticket {
  id            String             @id @default(cuid())
  ticketId      String             @unique
  customerId    String?
  customerName  String
  customerEmail String
  category      String
  subject       String
  description   String
  priority      String             @default("NORMAL")
  status        String             @default("NEW")
  assignedAgent String?
  department    String             @default("Support")
  tags          String?            @default("Inbound")
  lastReplyAt   DateTime           @default(now())
  closedAt      DateTime?
  createdAt     DateTime           @default(now())
  updatedAt     DateTime           @updatedAt
  aiAnalyses    AIAnalysis[]
  emailLogs     EmailLog[]
  internalNotes InternalNote[]
  customer      Customer?          @relation(fields: [customerId], references: [id])
  activities    TicketActivity[]
  attachments   TicketAttachment[]
  messages      TicketMessage[]    @relation("AdminTicketMessages")

  @@index([ticketId])
  @@index([customerEmail])
  @@index([status])
  @@index([priority])
  @@index([category])
}

model TicketMessage {
  id              String         @id @default(cuid())
  ticketId        String
  senderType      String?        @default("CUSTOMER")
  senderName      String
  senderEmail     String?
  message         String
  createdAt       DateTime       @default(now())
  sender          String?        @default("CUSTOMER")
  ticket          Ticket         @relation("AdminTicketMessages", fields: [ticketId], references: [id], onDelete: Cascade, map: "TicketMessage_admin_fkey")
  contactTicketId String?
  contactTicket   ContactTicket? @relation("ContactTicketMessages", fields: [contactTicketId], references: [ticketId], onDelete: Cascade, map: "TicketMessage_contact_fkey")

  @@index([ticketId])
}

model TicketAttachment {
  id        String   @id @default(cuid())
  ticketId  String
  fileName  String
  fileSize  String
  fileType  String
  url       String
  createdAt DateTime @default(now())
  ticket    Ticket   @relation(fields: [ticketId], references: [id], onDelete: Cascade)

  @@index([ticketId])
}

model InternalNote {
  id        String   @id @default(cuid())
  ticketId  String
  author    String
  note      String
  createdAt DateTime @default(now())
  ticket    Ticket   @relation(fields: [ticketId], references: [id], onDelete: Cascade)

  @@index([ticketId])
}

model TicketActivity {
  id        String   @id @default(cuid())
  ticketId  String
  action    String
  details   String?
  performer String
  createdAt DateTime @default(now())
  ticket    Ticket   @relation(fields: [ticketId], references: [id], onDelete: Cascade)

  @@index([ticketId])
}

model AIAnalysis {
  id               String   @id @default(cuid())
  ticketId         String
  summary          String
  detectedCategory String?
  detectedPriority String?
  spamScore        Float    @default(0)
  suggestedReply   String
  approved         Boolean  @default(false)
  createdAt        DateTime @default(now())
  ticket           Ticket   @relation(fields: [ticketId], references: [id], onDelete: Cascade)

  @@index([ticketId])
}

model Department {
  id          String       @id @default(cuid())
  name        String       @unique
  description String?
  createdAt   DateTime     @default(now())
  members     TeamMember[]
}

model TeamMember {
  id           String     @id @default(cuid())
  departmentId String
  name         String
  email        String     @unique
  role         String     @default("Support Agent")
  active       Boolean    @default(true)
  createdAt    DateTime   @default(now())
  department   Department @relation(fields: [departmentId], references: [id], onDelete: Cascade)

  @@index([departmentId])
}

model EmailLog {
  id           String   @id @default(cuid())
  ticketId     String?
  recipient    String
  subject      String
  status       String   @default("DISPATCHED")
  errorMessage String?
  createdAt    DateTime @default(now())
  ticket       Ticket?  @relation(fields: [ticketId], references: [id])

  @@index([recipient])
}

model AIConversation {
  id        String      @id @default(cuid())
  title     String
  userEmail String      @default("Admin")
  model     String      @default("gemini-2.5-flash")
  createdAt DateTime    @default(now())
  updatedAt DateTime    @updatedAt
  messages  AIMessage[]

  @@index([userEmail])
}

model AIMessage {
  id             String         @id @default(cuid())
  conversationId String
  role           String
  content        String
  createdAt      DateTime       @default(now())
  conversation   AIConversation @relation(fields: [conversationId], references: [id], onDelete: Cascade)

  @@index([conversationId])
}

model AIPrompt {
  id         String   @id @default(cuid())
  key        String   @unique
  title      String
  category   String   @default("General")
  promptText String
  active     Boolean  @default(true)
  version    Int      @default(1)
  createdAt  DateTime @default(now())
  updatedAt  DateTime @updatedAt

  @@index([key])
  @@index([category])
}

model AIUsage {
  id           String   @id @default(cuid())
  feature      String
  model        String   @default("gemini-2.5-flash")
  tokens       Int      @default(0)
  responseTime Float    @default(0)
  status       String   @default("SUCCESS")
  userEmail    String   @default("Admin")
  createdAt    DateTime @default(now())

  @@index([feature])
  @@index([createdAt])
}

model AISetting {
  id          String   @id @default(cuid())
  key         String   @unique
  value       String
  description String?
  updatedAt   DateTime @updatedAt
}

model AIKnowledge {
  id        String   @id @default(cuid())
  topic     String   @unique
  category  String   @default("Studio")
  content   String
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([category])
}

model AIActivity {
  id        String   @id @default(cuid())
  action    String
  details   String?
  userEmail String   @default("Admin")
  createdAt DateTime @default(now())
}

model AnalyticsEvent {
  id        String   @id @default(cuid())
  event     String
  category  String   @default("General")
  userEmail String?  @default("Visitor")
  ipAddress String?
  metadata  String?
  createdAt DateTime @default(now())

  @@index([event])
  @@index([createdAt])
}

model Visitor {
  id        String   @id @default(cuid())
  ipAddress String   @unique
  country   String?  @default("United States")
  language  String?  @default("en-US")
  device    String?  @default("Desktop")
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

model AnalyticsSession {
  id         String   @id @default(cuid())
  sessionKey String   @unique
  duration   Int      @default(0)
  pageViews  Int      @default(1)
  createdAt  DateTime @default(now())
}

model AnalyticsReport {
  id        String   @id @default(cuid())
  title     String
  type      String   @default("DAILY")
  data      String
  createdAt DateTime @default(now())
}

model Metric {
  id        String   @id @default(cuid())
  name      String   @unique
  value     Float
  unit      String?  @default("count")
  updatedAt DateTime @updatedAt
}

model DashboardWidget {
  id        String   @id @default(cuid())
  title     String
  type      String
  position  Int      @default(0)
  createdAt DateTime @default(now())
}

model SecurityEvent {
  id        String   @id @default(cuid())
  eventType String
  severity  String   @default("MEDIUM")
  userEmail String?  @default("Unknown")
  ipAddress String?
  details   String?
  createdAt DateTime @default(now())

  @@index([eventType])
  @@index([severity])
}

model APIKey {
  id         String   @id @default(cuid())
  name       String
  keyPrefix  String
  secretHash String
  active     Boolean  @default(true)
  createdBy  String   @default("Admin")
  createdAt  DateTime @default(now())

  @@index([name])
}

model SecurityAlert {
  id        String   @id @default(cuid())
  title     String
  severity  String   @default("HIGH")
  status    String   @default("OPEN")
  details   String
  createdAt DateTime @default(now())

  @@index([status])
}

model BackupRecord {
  id        String   @id @default(cuid())
  filename  String
  size      String
  status    String   @default("COMPLETED")
  createdBy String   @default("Automated System")
  createdAt DateTime @default(now())
}

model Notification {
  id        String   @id @default(cuid())
  title     String
  message   String
  type      String   @default("INFO")
  recipient String   @default("All Staff")
  isRead    Boolean  @default(false)
  channel   String   @default("IN_APP")
  createdAt DateTime @default(now())

  @@index([recipient])
  @@index([isRead])
}

model NotificationTemplate {
  id        String   @id @default(cuid())
  name      String   @unique
  subject   String
  body      String
  category  String   @default("General")
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

model NotificationPreference {
  id         String   @id @default(cuid())
  userEmail  String   @unique
  emailAlert Boolean  @default(true)
  inAppAlert Boolean  @default(true)
  createdAt  DateTime @default(now())
}

model NotificationRule {
  id        String   @id @default(cuid())
  event     String
  channel   String   @default("EMAIL")
  active    Boolean  @default(true)
  createdAt DateTime @default(now())
}

model DeliveryLog {
  id           String   @id @default(cuid())
  recipient    String
  channel      String   @default("EMAIL")
  status       String   @default("DELIVERED")
  errorMessage String?
  createdAt    DateTime @default(now())

  @@index([recipient])
}

model SystemSetting {
  id          String   @id @default(cuid())
  key         String   @unique
  value       String
  category    String   @default("General")
  description String?
  updatedBy   String   @default("Super Admin")
  updatedAt   DateTime @updatedAt

  @@index([key])
  @@index([category])
}

model Integration {
  id        String   @id @default(cuid())
  name      String   @unique
  provider  String
  status    String   @default("CONNECTED")
  enabled   Boolean  @default(true)
  config    String?
  updatedAt DateTime @updatedAt

  @@index([provider])
}

model EmailConfiguration {
  id          String   @id @default(cuid())
  smtpHost    String   @default("smtp.dragonstudios.com")
  smtpPort    Int      @default(587)
  username    String   @default("notifications@dragonstudios.com")
  senderEmail String   @default("support@dragonstudios.com")
  senderName  String   @default("Dragon Studios Enterprise")
  updatedAt   DateTime @updatedAt
}

model StorageConfiguration {
  id         String   @id @default(cuid())
  provider   String   @default("LOCAL")
  bucketName String   @default("dragon-media-production")
  region     String   @default("us-east-1")
  updatedAt  DateTime @updatedAt
}

model AIConfiguration {
  id           String   @id @default(cuid())
  defaultModel String   @default("gemini-2.5-flash")
  temperature  Float    @default(0.7)
  tokenLimit   Int      @default(8192)
  updatedAt    DateTime @updatedAt
}

model FeatureFlag {
  id          String   @id @default(cuid())
  key         String   @unique
  name        String
  enabled     Boolean  @default(true)
  description String?
  updatedAt   DateTime @updatedAt

  @@index([key])
}

model TestResult {
  id        String   @id @default(cuid())
  testName  String
  category  String   @default("UNIT")
  status    String   @default("PASSED")
  duration  Float    @default(0)
  details   String?
  createdAt DateTime @default(now())

  @@index([category])
  @@index([status])
}

model ErrorLog {
  id        String   @id @default(cuid())
  message   String
  stack     String?
  source    String   @default("SERVER")
  userEmail String?  @default("System")
  createdAt DateTime @default(now())

  @@index([source])
  @@index([createdAt])
}

model PerformanceMetric {
  id        String   @id @default(cuid())
  name      String
  value     Float
  unit      String   @default("ms")
  createdAt DateTime @default(now())

  @@index([name])
}

model Deployment {
  id          String   @id @default(cuid())
  version     String
  environment String   @default("PRODUCTION")
  status      String   @default("SUCCESS")
  deployedBy  String   @default("DevOps Automated")
  commitHash  String?  @default("a8f9c1e")
  createdAt   DateTime @default(now())
}

model BuildHistory {
  id        String   @id @default(cuid())
  buildNum  Int
  status    String   @default("SUCCESS")
  duration  String   @default("10.5s")
  createdAt DateTime @default(now())
}

model SystemLog {
  id        String   @id @default(cuid())
  level     String   @default("INFO")
  message   String
  createdAt DateTime @default(now())

  @@index([level])
}

model HealthCheck {
  id        String   @id @default(cuid())
  service   String   @unique
  status    String   @default("HEALTHY")
  latency   Float    @default(0)
  updatedAt DateTime @updatedAt
}

model CacheRecord {
  id        String   @id @default(cuid())
  key       String   @unique
  hitCount  Int      @default(1)
  expiresAt DateTime
  createdAt DateTime @default(now())
}

model OptimizationReport {
  id        String   @id @default(cuid())
  title     String
  summary   String
  createdAt DateTime @default(now())
}

model SystemResource {
  id          String   @id @default(cuid())
  nodeId      String   @default("node-us-east-1a")
  cpuUsage    Float    @default(14.2)
  memoryUsage Float    @default(38.4)
  diskUsage   Float    @default(24.8)
  updatedAt   DateTime @updatedAt
}

model ProductionEnvironment {
  id        String   @id @default(cuid())
  name      String   @unique
  domain    String   @default("admin.dragonstudios.com")
  status    String   @default("ACTIVE")
  updatedAt DateTime @updatedAt
}

model CloudDeployment {
  id         String   @id @default(cuid())
  version    String
  branch     String   @default("main")
  commit     String   @default("a8f9c1e")
  status     String   @default("SUCCESS")
  deployedBy String   @default("DevOps Pipeline")
  createdAt  DateTime @default(now())
}

model SystemHealthCheck {
  id         String   @id @default(cuid())
  endpoint   String   @unique
  status     String   @default("UP")
  httpStatus Int      @default(200)
  updatedAt  DateTime @updatedAt
}

model DatabaseBackupRecord {
  id         String   @id @default(cuid())
  filename   String
  size       String
  status     String   @default("COMPLETED")
  storageUrl String?
  createdAt  DateTime @default(now())
}

model Workflow {
  id          String              @id @default(cuid())
  name        String
  description String?
  status      String              @default("ACTIVE")
  category    String              @default("CRM")
  triggerType String              @default("CRM_TICKET_CREATED")
  actionType  String              @default("SEND_EMAIL_DISPATCH")
  createdAt   DateTime            @default(now())
  updatedAt   DateTime            @updatedAt
  actions     WorkflowAction[]
  conditions  WorkflowCondition[]
  executions  WorkflowExecution[]
  triggers    WorkflowTrigger[]

  @@index([status])
  @@index([category])
}

model WorkflowTrigger {
  id         String   @id @default(cuid())
  workflowId String
  eventType  String
  payload    String?
  createdAt  DateTime @default(now())
  workflow   Workflow @relation(fields: [workflowId], references: [id], onDelete: Cascade)

  @@index([workflowId])
}

model WorkflowCondition {
  id         String   @id @default(cuid())
  workflowId String
  operator   String   @default("IF")
  field      String
  comparison String   @default("EQUALS")
  value      String
  createdAt  DateTime @default(now())
  workflow   Workflow @relation(fields: [workflowId], references: [id], onDelete: Cascade)

  @@index([workflowId])
}

